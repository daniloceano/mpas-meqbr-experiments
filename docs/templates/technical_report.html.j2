          <label>Experimento A<select id="pair-experiment-a"></select></label>
          <label>Experimento B<select id="pair-experiment-b"></select></label>
          <label>Sítio<select id="pair-site"></select></label>
          <label>Período<select id="pair-period"></select></label>
          <label>Altura<select id="pair-height"></select></label>
        </div>
