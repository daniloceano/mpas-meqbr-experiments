<script>
  (() => {
    const lightbox = document.getElementById('figure-lightbox');
    const image = document.getElementById('lightbox-image');
    const title = document.getElementById('lightbox-title');
    const newTab = document.getElementById('lightbox-new-tab');
    const closeButton = lightbox.querySelector('.lightbox-close');
    let lastTrigger = null;

    function closeLightbox() {
      lightbox.hidden = true;
      image.removeAttribute('src');
      document.body.classList.remove('lightbox-open');
      if (lastTrigger) lastTrigger.focus();
    }

    document.querySelectorAll('.figure-zoom').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        lastTrigger = trigger;
        image.src = trigger.dataset.full;
        image.alt = trigger.dataset.title;
        title.textContent = trigger.dataset.title;
        newTab.href = trigger.dataset.full;
        lightbox.hidden = false;
        document.body.classList.add('lightbox-open');
        closeButton.focus();
      });
    });
    closeButton.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !lightbox.hidden) closeLightbox();
    });

    document.querySelectorAll('[data-media-explorer]').forEach((root) => {
      const select = root.querySelector('select');
      if (!select) return;
      const figures = [...root.querySelectorAll('[data-media-index]')];
      select.addEventListener('change', () => {
        figures.forEach((figure) => { figure.hidden = figure.dataset.mediaIndex !== select.value; });
      });
    });

    const tableElement = document.getElementById('table-data');
    const tableData = tableElement ? JSON.parse(tableElement.textContent) : {};
    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    })[char]);
    const csvValue = (value) => {
      const text = value == null ? '' : String(value);
      return /[;"\n]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
    };

    document.querySelectorAll('.table-explorer[data-table-id]').forEach((root) => {
      const spec = tableData[root.dataset.tableId];
      if (!spec) return;
      const toolbar = root.querySelector('.table-toolbar');
      const tbody = root.querySelector('tbody');
      const count = root.querySelector('.table-count');
      const state = {filters: {}, sort: '', descending: false, visible: spec.rows};

      spec.filters.forEach((column) => {
        const label = document.createElement('label');
        label.textContent = spec.labels[column];
        const select = document.createElement('select');
        select.innerHTML = '<option value="">Todos</option>';
        const values = [...new Set(spec.rows.map((row) => row.raw[column]).filter((value) => value != null))]
          .sort((a, b) => String(a).localeCompare(String(b), 'pt-BR', {numeric: true}));
        values.forEach((value) => select.add(new Option(String(value), String(value))));
        select.addEventListener('change', () => { state.filters[column] = select.value; render(); });
        label.appendChild(select); toolbar.appendChild(label);
      });

      if (spec.numeric.length) {
        const label = document.createElement('label'); label.textContent = 'Ordenar por métrica';
        const select = document.createElement('select');
        select.innerHTML = '<option value="">Ordem original</option>';
        spec.numeric.forEach((column) => select.add(new Option(spec.labels[column], column)));
        select.addEventListener('change', () => { state.sort = select.value; render(); });
        label.appendChild(select); toolbar.appendChild(label);

        const directionLabel = document.createElement('label'); directionLabel.textContent = 'Direção';
        const direction = document.createElement('select');
        direction.innerHTML = '<option value="asc">Menor → maior</option><option value="desc">Maior → menor</option>';
        direction.addEventListener('change', () => { state.descending = direction.value === 'desc'; render(); });
        directionLabel.appendChild(direction); toolbar.appendChild(directionLabel);
      }

      const exportWrap = document.createElement('label'); exportWrap.textContent = 'Dados visíveis';
      const exportButton = document.createElement('button'); exportButton.type = 'button'; exportButton.textContent = 'Exportar CSV filtrado';
      exportButton.addEventListener('click', () => {
        const lines = [spec.columns.map((column) => csvValue(spec.labels[column])).join(';')];
        state.visible.forEach((row) => lines.push(spec.columns.map((column) => csvValue(row.values[column])).join(';')));
        const blob = new Blob([`\ufeff${lines.join('\n')}\n`], {type: 'text/csv;charset=utf-8'});
        const url = URL.createObjectURL(blob); const link = document.createElement('a');
        link.href = url; link.download = `${spec.id}-filtrado.csv`; link.click(); URL.revokeObjectURL(url);
      });
      exportWrap.appendChild(exportButton); toolbar.appendChild(exportWrap);

      function render() {
        let rows = spec.rows.filter((row) => Object.entries(state.filters).every(([column, value]) =>
          !value || String(row.raw[column]) === value));
        if (state.sort) rows = [...rows].sort((a, b) => {
          const av = Number(a.raw[state.sort]), bv = Number(b.raw[state.sort]);
          const aFinite = Number.isFinite(av), bFinite = Number.isFinite(bv);
          if (!aFinite && !bFinite) return 0;
          if (!aFinite) return 1;
          if (!bFinite) return -1;
          return (state.descending ? -1 : 1) * (av - bv);
        });
        state.visible = rows;
        tbody.innerHTML = rows.map((row) => `<tr${row.row_classes ? ` class="${escapeHtml(row.row_classes)}"` : ''}>${spec.columns.map((column) => {
          const css = row.cell_classes[column];
          return `<td${css ? ` class="${escapeHtml(css)}"` : ''}>${escapeHtml(row.values[column])}</td>`;
        }).join('')}</tr>`).join('');
        count.textContent = `${rows.length} de ${spec.rows.length} linhas exibidas. Destaque amarelo = melhor valor numérico no grupo científico comparável; não implica significância.`;
      }
      render();
    });
  })();

  (() => {
    const NS = 'http://www.w3.org/2000/svg';
    const parseData = (id) => {
      const element = document.getElementById(id);
      return element ? JSON.parse(element.textContent) : null;
    };
    const number = (value, digits=2) => value == null || !Number.isFinite(Number(value))
      ? '—' : Number(value).toLocaleString('pt-BR', {minimumFractionDigits: digits, maximumFractionDigits: digits});
    const interval = (row, key, digits=2) => `${number(row[key], digits)} [${number(row[key + '_lo'], digits)}; ${number(row[key + '_hi'], digits)}]`;
    const svgElement = (name, attrs={}) => {
      const element = document.createElementNS(NS, name);
      Object.entries(attrs).forEach(([key, value]) => element.setAttribute(key, value));
      return element;
    };

    function geographicSvg(stage, data, imageUrl=null) {
      const [x0, x1, y0, y1] = data.extent;
      const initial = {x: x0, y: -y1, w: x1 - x0, h: y1 - y0};
      const svg = svgElement('svg', {
        viewBox: `${initial.x} ${initial.y} ${initial.w} ${initial.h}`,
        preserveAspectRatio: 'xMidYMid meet', role: 'img',
        'aria-label': 'Mapa geográfico interativo'
      });
      if (imageUrl) svg.appendChild(svgElement('image', {
        href: imageUrl, x: x0, y: -y1, width: x1 - x0, height: y1 - y0,
        preserveAspectRatio: 'none'
      }));
      for (let lon = Math.ceil(x0 / 2) * 2; lon <= x1; lon += 2) {
        svg.appendChild(svgElement('line', {x1: lon, x2: lon, y1: -y1, y2: -y0, class: 'map-grid'}));
      }
      for (let lat = Math.ceil(y0 / 2) * 2; lat <= y1; lat += 2) {
        svg.appendChild(svgElement('line', {x1: x0, x2: x1, y1: -lat, y2: -lat, class: 'map-grid'}));
      }
      (data.coastline || []).forEach((line) => {
        const points = line.map(([lon, lat]) => `${lon},${-lat}`).join(' ');
        svg.appendChild(svgElement('polyline', {points, class: 'map-coast'}));
      });
      stage.replaceChildren(svg);
      const readout = document.createElement('span');
      readout.className = 'cursor-readout';
      readout.textContent = 'lon — · lat —';
      stage.appendChild(readout);
      let box = {...initial};
      let drag = null;
      const apply = () => svg.setAttribute('viewBox', `${box.x} ${box.y} ${box.w} ${box.h}`);
      const svgPoint = (event) => {
        const point = svg.createSVGPoint();
        point.x = event.clientX;
        point.y = event.clientY;
        return point.matrixTransform(svg.getScreenCTM().inverse());
      };
      svg.addEventListener('wheel', (event) => {
        event.preventDefault();
        const cursor = svgPoint(event);
        const factor = event.deltaY > 0 ? 1.18 : .84;
        const nw = Math.min(initial.w, Math.max(initial.w / 12, box.w * factor));
        const nh = nw * initial.h / initial.w;
        const ratio = nw / box.w;
        box.x = cursor.x - (cursor.x - box.x) * ratio;
        box.y = cursor.y - (cursor.y - box.y) * ratio;
        box.w = nw; box.h = nh; apply();
      }, {passive: false});
      svg.addEventListener('pointerdown', (event) => {
        if (event.target.closest && event.target.closest('.map-point')) return;
        svg.setPointerCapture(event.pointerId);
        drag = {x: event.clientX, y: event.clientY};
      });
      svg.addEventListener('pointermove', (event) => {
        const cursor = svgPoint(event);
        const lon = cursor.x;
        const lat = -cursor.y;
        readout.textContent = `lon ${lon.toFixed(2)}° · lat ${lat.toFixed(2)}°`;
        if (!drag) return;
        const matrix = svg.getScreenCTM();
        box.x -= (event.clientX - drag.x) / Math.abs(matrix.a);
        box.y -= (event.clientY - drag.y) / Math.abs(matrix.d);
        drag.x = event.clientX;
        drag.y = event.clientY;
        apply();
      });
      const endDrag = () => { drag = null; };
      svg.addEventListener('pointerup', endDrag);
      svg.addEventListener('pointercancel', endDrag);
      return {svg, reset: () => { box = {...initial}; apply(); }};
    }

    const meteo = parseData('meteo-data');
    if (meteo && document.getElementById('meteo-viewer')) {
      const experiment = document.getElementById('meteo-experiment');
      const period = document.getElementById('meteo-period');
      const variable = document.getElementById('meteo-variable');
      const stage = document.getElementById('meteo-stage');
      const detail = document.getElementById('meteo-detail');
      const status = document.getElementById('meteo-status');
      let resetMap = () => {};
      meteo.experiments.forEach((value) => experiment.add(new Option(value, value)));
      Object.entries(meteo.periods).forEach(([key, value]) => period.add(new Option(value.label, key)));
      Object.entries(meteo.variables).forEach(([key, value]) => variable.add(new Option(value.label, key)));

      function renderMeteo() {
        const entry = meteo.entries.find((item) => item.experiment === experiment.value
          && item.period === period.value && item.variable === variable.value && item.available !== false);
        if (!entry) {
          stage.innerHTML = `<div class="unavailable"><div><strong>Produto indisponível</strong><br>
            ${experiment.value} · ${meteo.periods[period.value].label} · ${meteo.variables[variable.value].label}</div></div>`;
          detail.innerHTML = '<h4>Combinação não produzida</h4><p>Nenhum resultado de outro experimento ou período foi usado como substituto.</p>';
          status.textContent = 'Indisponível — seleção preservada sem substituição silenciosa.';
          resetMap = () => {};
          return;
        }
        if (entry.kind === 'georaster') {
          const map = geographicSvg(stage, meteo, entry.url);
          resetMap = map.reset;
          const gradient = entry.colour_stops.map((stop) => `${stop.colour} ${stop.fraction * 100}%`).join(',');
          detail.innerHTML = `<h4>${entry.variable_label}</h4>
            <p><strong>${entry.experiment}</strong> · ${meteo.periods[entry.period].label}</p>
            <p>${entry.n_hours} horários: ${entry.window_start} a ${entry.window_end}</p>
            <div class="colourbar" style="background:linear-gradient(90deg,${gradient})"></div>
            <div class="colourbar-labels"><span>${number(entry.vmin)} ${entry.unit}</span><span>${number(entry.vmax)} ${entry.unit}</span></div>
            <p><small>${entry.projection}. Escala fixa para esta variável em todos os experimentos e períodos.</small></p>`;
          status.textContent = `${entry.limitation} Use a roda/pinça para zoom e arraste para deslocar.`;
        } else if (entry.kind === 'animation') {
          const video = document.createElement(entry.source.endsWith('.gif') ? 'img' : 'video');
          video.className = 'diagnostic-image'; video.src = entry.url;
          if (video.tagName === 'VIDEO') { video.controls = true; video.preload = 'metadata'; }
          stage.replaceChildren(video); resetMap = () => { if (video.tagName === 'VIDEO') video.currentTime = 0; };
          detail.innerHTML = `<h4>${entry.variable_label}</h4><p><strong>${entry.experiment}</strong> · ${meteo.periods[entry.period].label}</p>
            <p>${entry.site ? `Transecto: ${entry.site}. ` : ''}Janela: ${entry.days} dias a partir de ${entry.start}.</p>
            ${entry.coverage_note ? `<p class="provisional">${entry.coverage_note}</p>` : ''}
            <p><small>Reprodução sem interpolação: cada quadro representa um horário modelado.</small></p>`;
          const base = entry.start ? new Date(`${entry.start.slice(0,4)}-${entry.start.slice(4,6)}-${entry.start.slice(6,8)}T00:00:00Z`) : null;
          const updateTime = () => {
            if (!base || video.tagName !== 'VIDEO') return;
            const frame = Math.round(video.currentTime * (entry.fps || 6));
            const when = new Date(base.getTime() + frame * (entry.frame_hours || 1) * 3600000);
            status.textContent = `Quadro ${frame + 1} · ${when.toISOString().slice(0,16).replace('T',' ')} UTC. ${entry.limitation}`;
          };
          if (video.tagName === 'VIDEO') video.addEventListener('timeupdate', updateTime);
          updateTime();
        } else {
          const image = document.createElement('img'); image.className = 'diagnostic-image'; image.src = entry.url;
          image.alt = `${entry.variable_label} — ${entry.experiment} ${entry.period}`;
          stage.replaceChildren(image); resetMap = () => {};
          detail.innerHTML = `<h4>${entry.variable_label}</h4><p><strong>${entry.experiment}</strong> · ${meteo.periods[entry.period].label}</p>
            <p>${entry.site ? `Local: ${entry.site}. ` : ''}${entry.unit}.</p>`;
          status.textContent = entry.limitation;
        }
      }
      [experiment, period, variable].forEach((control) => control.addEventListener('change', renderMeteo));
      document.getElementById('meteo-reset').addEventListener('click', () => resetMap());
      renderMeteo();
    }

    const validation = parseData('validation-data');
    const selectionBridge = {
      state: null,
      listeners: [],
      update(next, origin) {
        this.state = {...next};
        this.listeners.forEach((listener) => listener(this.state, origin));
      },
      subscribe(listener) { this.listeners.push(listener); }
    };
    const addPointMarker = (map, point, active, available, onClick) => {
      let marker;
      if (point.network === 'LiDAR') {
        marker = svgElement('circle', {cx: point.lon, cy: -point.lat, r: .13});
      } else {
        const x = point.lon, y = -point.lat, s = .15;
        marker = svgElement('polygon', {points: `${x},${y-s} ${x-s},${y+s} ${x+s},${y+s}`});
      }
      marker.setAttribute('class', `map-point${active ? ' active' : ''}`);
      marker.setAttribute('fill', available ? (point.network === 'LiDAR' ? '#d1495b' : '#006d77') : '#9aa7ad');
      const title = svgElement('title');
      title.textContent = `${point.name} — ${available ? 'dados disponíveis' : 'indisponível no período'}`;
      marker.appendChild(title); marker.addEventListener('click', onClick); map.svg.appendChild(marker);
    };

    if (validation && meteo && document.getElementById('network-viewer')) {
      const period = document.getElementById('network-period');
      const network = document.getElementById('network-kind');
      const stage = document.getElementById('network-stage');
      const detail = document.getElementById('network-detail');
      const status = document.getElementById('network-status');
      let selected = null; let resetMap = () => {};
      Object.entries(validation.periods).forEach(([key, value]) => period.add(new Option(value.label, key)));
      function renderNetwork() {
        const map = geographicSvg(stage, meteo); resetMap = map.reset;
        validation.points.forEach((point) => {
          if (network.value !== 'all' && point.network !== network.value) return;
          const available = point.available_periods.includes(period.value);
          addPointMarker(map, point, selected && selected.point === point.point, available, () => {
            selected = point;
            const selectedPeriod = point.available_periods.includes(period.value)
              ? period.value : point.available_periods[0];
            const heights = [...new Set(validation.metrics.filter((row) => row.point === point.point
              && row.period === selectedPeriod).map((row) => row.height_m))].sort((a,b) => a-b);
            const previousHeight = selectionBridge.state && Number(selectionBridge.state.height);
            const selectedHeight = heights.includes(previousHeight) ? previousHeight
              : (heights.includes(100) ? 100 : heights[0]);
            selectionBridge.update({network: point.network, point: point.point,
              period: selectedPeriod, height: selectedHeight}, 'network-map');
            renderNetwork();
          });
        });
        if (!selected) {
          detail.innerHTML = '<h4>Selecione um ponto</h4><p>Círculos: LiDAR; triângulos: INMET. Cinza indica ausência de produto no período.</p>';
        } else {
          detail.innerHTML = `<h4>${selected.name}</h4>
            <p>${selected.network} · ${selected.lat.toFixed(3)}°, ${selected.lon.toFixed(3)}°</p>
            <dl><dt>Instrumento</dt><dd>${selected.instrument}</dd>
            <dt>Períodos disponíveis</dt><dd>${selected.available_periods.map((key) => validation.periods[key].label).join('; ')}</dd>
            <dt>Alturas</dt><dd>${selected.available_heights_m.join(', ')} m</dd>
            <dt>Qualidade</dt><dd>${selected.quality_control}</dd>
            <dt>Correspondência</dt><dd>${selected.model_matching}</dd></dl>
            <button type="button" class="panel-action" id="network-to-validation">Ir para métricas deste ponto</button>`;
          detail.querySelector('#network-to-validation').addEventListener('click', () => {
            document.getElementById('painel-validacao').scrollIntoView({behavior: 'smooth', block: 'start'});
            document.getElementById('validation-point').focus();
          });
        }
        status.textContent = 'A seleção descreve disponibilidade e método; métricas e figuras são exploradas na seção seguinte.';
      }
      selectionBridge.subscribe((state, origin) => {
        if (origin === 'network-map') return;
        const candidate = validation.points.find((item) => item.point === state.point);
        if (!candidate) return;
        selected = candidate;
        network.value = candidate.network;
        if (candidate.available_periods.includes(state.period)) period.value = state.period;
        renderNetwork();
      });
      period.addEventListener('change', () => {
        if (selected && selected.available_periods.includes(period.value)) {
          selectionBridge.update({...selectionBridge.state, network: selected.network,
            point: selected.point, period: period.value}, 'network-map');
        } else selected = null;
        renderNetwork();
      });
      network.addEventListener('change', () => { selected = null; renderNetwork(); });
      document.getElementById('network-reset').addEventListener('click', () => resetMap());
      renderNetwork();
    }

    if (validation && document.getElementById('validation-viewer')) {
      const network = document.getElementById('validation-network');
      const point = document.getElementById('validation-point');
      const period = document.getElementById('validation-period');
      const height = document.getElementById('validation-height');
      const chart = document.getElementById('validation-chart');
      const sourceRoot = document.getElementById('validation-sources');
      const stage = document.getElementById('validation-stage');
      const detail = document.getElementById('validation-detail');
      const status = document.getElementById('validation-status');
      const selectedSources = new Set(validation.sources);
      const sourceOrder = ['ERA5', 'CTL', 'EXP01', 'EXP02', 'EXP03'];
      sourceOrder.filter((source) => validation.sources.includes(source)).forEach((source) => {
        const label = document.createElement('label');
        label.innerHTML = `<input type="checkbox" value="${source}" checked> ${source}`;
        const input = label.querySelector('input');
        input.addEventListener('change', () => {
          if (input.checked) selectedSources.add(source); else selectedSources.delete(source);
          if (!selectedSources.size) { input.checked = true; selectedSources.add(source); }
          renderValidation();
        });
        sourceRoot.appendChild(label);
      });

      const setOptions = (control, entries, preferred) => {
        const old = preferred ?? control.value;
        control.replaceChildren(...entries.map(([value, label]) => new Option(label, value)));
        if (entries.some(([value]) => String(value) === String(old))) control.value = old;
      };
      const currentPoint = () => validation.points.find((item) => item.point === point.value);
      const matchingMedia = () => validation.media.filter((item) => item.network === network.value
        && (item.point === point.value || item.point === 'all')
        && (item.period === period.value || item.period === 'all')
        && (!item.heights.length || item.heights.includes(Number(height.value))));

      function syncControls(preferred={}) {
        if (preferred.network && [...network.options].some((item) => item.value === preferred.network)) network.value = preferred.network;
        const points = validation.points.filter((item) => item.network === network.value);
        setOptions(point, points.map((item) => [item.point, item.name]), preferred.point);
        const selectedPoint = currentPoint();
        if (!selectedPoint) return;
        setOptions(period, selectedPoint.available_periods.map((key) => [key, validation.periods[key].label]), preferred.period);
        const heights = [...new Set(validation.metrics.filter((row) => row.point === point.value
          && row.period === period.value).map((row) => row.height_m))].sort((a,b) => a-b);
        const requestedHeight = Number(preferred.height ?? height.value);
        const selectedHeight = heights.includes(requestedHeight) ? requestedHeight
          : (heights.includes(100) ? 100 : heights[0]);
        setOptions(height, heights.map((value) => [String(value), `${value} m`]), String(selectedHeight));
        const media = matchingMedia();
        const chartEntries = [['metrics', 'Métricas e intervalos']];
        [...new Map(media.map((item) => [item.chart, item.chart_label])).entries()].forEach((entry) => chartEntries.push(entry));
        setOptions(chart, chartEntries, preferred.chart);
        renderValidation();
      }

      const bestValue = (rows, key, mode) => {
        const values = rows.filter((row) => ['CTL','EXP01','EXP02','EXP03'].includes(row.source))
          .map((row) => mode === 'abs' ? Math.abs(row[key]) : row[key]).filter(Number.isFinite);
        return values.length ? (mode === 'max' ? Math.max(...values) : Math.min(...values)) : null;
      };
      const bestSources = (rows, key, mode) => {
        const target = bestValue(rows, key, mode);
        return target == null ? [] : rows.filter((row) => ['CTL','EXP01','EXP02','EXP03'].includes(row.source)
          && Number.isFinite(row[key])
          && Math.abs((mode === 'abs' ? Math.abs(row[key]) : row[key]) - target) < 1e-10).map((row) => row.source);
      };
      const marked = (value, target, mode, text) => {
        const transformed = mode === 'abs' ? Math.abs(value) : value;
        return target != null && Number.isFinite(transformed) && Math.abs(transformed - target) < 1e-10
          ? `<span class="metric-best">${text}</span>` : text;
      };
      const skillBadge = (row) => {
        if (row.source === 'ERA5') return '<span class="skill-badge skill-na">Referência ERA5</span>';
        if (![row.skill_vs_era5, row.skill_lo, row.skill_hi].every((value) => Number.isFinite(value)))
          return '<span class="skill-badge skill-na">Não avaliado nesta altura</span>';
        if (row.skill_lo > 0) return '<span class="skill-badge skill-gain">Ganho detectável</span>';
        if (row.skill_hi < 0) return '<span class="skill-badge skill-loss">Perda detectável</span>';
        return '<span class="skill-badge skill-neutral">Diferença não detectável</span>';
      };

      function renderValidation() {
        const selectedPoint = currentPoint(); if (!selectedPoint) return;
        const inputs = [...sourceRoot.querySelectorAll('input')];
        if (chart.value === 'metrics') {
          inputs.forEach((input) => { input.disabled = false; });
          const allRows = validation.metrics.filter((row) => row.point === point.value
            && row.period === period.value && row.height_m === Number(height.value))
            .sort((a,b) => sourceOrder.indexOf(a.source) - sourceOrder.indexOf(b.source));
          const rows = allRows.filter((row) => selectedSources.has(row.source));
          const best = {rmse: bestValue(allRows, 'rmse', 'min'), bias: bestValue(allRows, 'bias', 'abs'), r: bestValue(allRows, 'r', 'max')};
          const winners = {
            rmse: bestSources(allRows, 'rmse', 'min'),
            bias: bestSources(allRows, 'bias', 'abs'),
            r: bestSources(allRows, 'r', 'max')
          };
          const reference = rows.find((row) => row.source === 'ERA5');
          const mpasRows = rows.filter((row) => row.source !== 'ERA5');
          const referenceHtml = reference ? `<div class="metric-reference" data-source="ERA5">
            <div><strong>Referência ERA5</strong><p>Benchmark observacional; não participa da escolha do melhor MPAS.</p></div>
            <div><strong>RMSE ${interval(reference,'rmse')} <span class="metric-unit">m s⁻¹</span></strong>
            <small>Viés ${interval(reference,'bias')} m s⁻¹ · r ${interval(reference,'r')}</small></div></div>` : '';
          const cardsHtml = mpasRows.map((row) => `<div class="metric-card" data-source="${row.source}">
            <small class="source-name">${row.source}</small>
            <strong class="metric-primary">RMSE ${marked(row.rmse, best.rmse, 'min', number(row.rmse))} <span class="metric-unit">m s⁻¹</span></strong>
            <div class="metric-secondary">
              <span class="metric-interval">IC95% [${number(row.rmse_lo)}; ${number(row.rmse_hi)}]</span>
              <span>Viés ${marked(row.bias, best.bias, 'abs', number(row.bias))} <span class="metric-unit">m s⁻¹</span> <span class="metric-interval">[${number(row.bias_lo)}; ${number(row.bias_hi)}]</span></span>
              <span>Correlação r ${marked(row.r, best.r, 'max', number(row.r))} <span class="metric-interval">[${number(row.r_lo)}; ${number(row.r_hi)}]</span></span>
              <span>Murphy skill (adimensional) ${Number.isFinite(row.skill_vs_era5) ? `${number(row.skill_vs_era5)} [${number(row.skill_lo)}; ${number(row.skill_hi)}]` : '—'}</span>
            </div>${skillBadge(row)}</div>`).join('');
          const hiddenWinner = Object.entries(winners).flatMap(([metric, sources]) => {
            const hidden = sources.filter((source) => !selectedSources.has(source));
            return hidden.length ? [`${metric === 'rmse' ? 'RMSE' : metric === 'bias' ? 'viés absoluto' : 'correlação'}: ${hidden.join(', ')}`] : [];
          });
          const hiddenHtml = hiddenWinner.length ? `<p class="hidden-winner-note"><strong>Melhor resultado oculto pelos filtros:</strong> ${hiddenWinner.join(' · ')}. O destaque não foi transferido para outra configuração.</p>` : '';
          stage.innerHTML = rows.length ? `<div class="validation-metrics">${referenceHtml}<div class="metric-grid metric-grid-mpas">${cardsHtml}</div>${hiddenHtml}</div>`
            : '<div class="unavailable"><strong>Combinação sem métricas visíveis</strong></div>';
          const role = allRows.some((row) => row.selection_role === 'descriptive_only')
            ? '<p class="provisional">Esta altura é descritiva e não participa dos testes de seleção.</p>' : '';
          detail.innerHTML = `<h4>${selectedPoint.name}</h4><p>${network.value} · ${validation.periods[period.value].label} · ${height.value} m</p>${role}
            <p><strong>Amarelo:</strong> melhor resultado numérico entre os quatro experimentos MPAS, inclusive quando algum cartão está oculto. Os badges comunicam separadamente a evidência estatística frente ao ERA5.</p>`;
          status.textContent = `${validation.methods.confidence_interval}. Murphy skill é adimensional e aparece em escala decimal: 0,41 significa redução de 41% do MSE do modelo frente ao ERA5, nos mesmos horários. Vencedores globais: RMSE ${winners.rmse.join('/') || '—'}; viés ${winners.bias.join('/') || '—'}; r ${winners.r.join('/') || '—'}.`;
        } else {
          inputs.forEach((input) => { input.disabled = true; });
          const item = matchingMedia().find((entry) => entry.chart === chart.value);
          if (!item) {
            stage.innerHTML = '<div class="unavailable"><strong>Figura indisponível para esta combinação</strong></div>';
            detail.innerHTML = '<h4>Produto não produzido</h4><p>Nenhuma figura de outro ponto, período ou altura foi usada como substituta.</p>';
            status.textContent = 'Indisponível — combinação preservada sem substituição silenciosa.'; return;
          }
          stage.innerHTML = `<img src="${item.url}" alt="${item.title}">`;
          detail.innerHTML = `<h4>${item.title}</h4><p>${item.caption}</p>
            <p><a href="${item.url}" target="_blank" rel="noopener">Abrir figura original</a></p>
            <p><small>PNG pré-renderizado; não é um gráfico recalculado no navegador.</small></p>`;
          status.textContent = 'A figura original contém as fontes definidas na sua geração. Os seletores de experimentos ficam desabilitados para não simular filtragem inexistente.';
        }
      }
      const publishSelection = () => selectionBridge.update({network: network.value, point: point.value,
        period: period.value, height: Number(height.value)}, 'validation');
      selectionBridge.subscribe((state, origin) => {
        if (origin === 'validation') return;
        syncControls(state);
      });
      network.addEventListener('change', () => { syncControls({network: network.value}); publishSelection(); });
      point.addEventListener('change', () => { syncControls({point: point.value, period: period.value, height: height.value}); publishSelection(); });
      period.addEventListener('change', () => { syncControls({point: point.value, period: period.value, height: height.value}); publishSelection(); });
      height.addEventListener('change', () => { renderValidation(); publishSelection(); });
      chart.addEventListener('change', renderValidation);
      syncControls({network: network.value});
      publishSelection();
    }

    const mpasSources = ['CTL', 'EXP01', 'EXP02', 'EXP03'];
    const isFiniteValue = (value) => value !== null && value !== '' && Number.isFinite(Number(value));
    const finiteMean = (values) => {
      const valid = values.filter(isFiniteValue).map(Number);
      return valid.length ? valid.reduce((total, value) => total + value, 0) / valid.length : null;
    };
    const classifySkill = (row) => {
      if (![row.skill_vs_era5, row.skill_lo, row.skill_hi].every(isFiniteValue)) return 'not_evaluated';
      if (Number(row.skill_lo) > 0) return 'gain';
      if (Number(row.skill_hi) < 0) return 'loss';
      return 'not_detected';
    };
    const aggregateMetrics = (rows) => mpasSources.map((source) => {
      const sourceRows = rows.filter((row) => row.source === source);
      const skillRows = sourceRows.filter((row) => isFiniteValue(row.skill_vs_era5));
      return {
        source,
        bias: finiteMean(sourceRows.map((row) => row.bias)),
        rmse: finiteMean(sourceRows.map((row) => row.rmse)),
        r: finiteMean(sourceRows.map((row) => row.r)),
        skill_vs_era5: finiteMean(skillRows.map((row) => row.skill_vs_era5)),
        n_units: sourceRows.length,
        n_skill_units: skillRows.length
      };
    });
    const aggregateWinners = (aggregates, metric) => {
      const available = aggregates.filter((row) => Number.isFinite(row[metric]));
      if (!available.length) return [];
      const transformed = (row) => metric === 'bias' ? Math.abs(row.bias) : row[metric];
      const target = metric === 'r' || metric === 'skill_vs_era5'
        ? Math.max(...available.map(transformed)) : Math.min(...available.map(transformed));
      return available.filter((row) => Math.abs(transformed(row) - target) < 1e-10).map((row) => row.source);
    };
    const orientPairwise = (rows, experimentA, experimentB, site, period, height) => {
      const matching = rows.find((row) => String(row.site) === String(site)
        && String(row.period) === String(period) && Number(row.height_m) === Number(height)
        && ((row.experiment_a === experimentA && row.experiment_b === experimentB)
          || (row.experiment_a === experimentB && row.experiment_b === experimentA)));
      if (!matching) return null;
      const direct = matching.experiment_a === experimentA;
      return direct ? {...matching, experiment_a: experimentA, experiment_b: experimentB}
        : {...matching, experiment_a: experimentA, experiment_b: experimentB,
          rmse_a: matching.rmse_b, rmse_b: matching.rmse_a,
          delta_mse: -Number(matching.delta_mse), lo: -Number(matching.hi), hi: -Number(matching.lo)};
    };
    window.MEQReportAudit = {isFiniteValue, finiteMean, classifySkill, aggregateMetrics, aggregateWinners, orientPairwise};

    if (validation && document.getElementById('resumo-descritivo')) {
      const network = document.getElementById('summary-network');
      const metric = document.getElementById('summary-metric');
      const pointRoot = document.getElementById('summary-points');
      const periodRoot = document.getElementById('summary-periods');
      const heightRoot = document.getElementById('summary-heights');
      const meta = document.getElementById('summary-meta');
      const results = document.getElementById('summary-results');
      const gainLoss = document.getElementById('gain-loss-results');
      const status = document.getElementById('summary-status');

      const checked = (root) => new Set([...root.querySelectorAll('input:checked')].map((input) => input.value));
      const renderChecks = (root, entries, preserved, onChange) => {
        const allowed = new Set(entries.map(([value]) => String(value)));
        const selected = new Set([...preserved].filter((value) => allowed.has(String(value))).map(String));
        if (!selected.size) entries.forEach(([value]) => selected.add(String(value)));
        root.replaceChildren(...entries.map(([value, label]) => {
          const wrapper = document.createElement('label');
          const input = document.createElement('input');
          input.type = 'checkbox'; input.value = String(value); input.checked = selected.has(String(value));
          input.addEventListener('change', () => {
            if (!root.querySelector('input:checked')) input.checked = true;
            onChange();
          });
          wrapper.append(input, document.createTextNode(` ${label}`));
          return wrapper;
        }));
      };
      const rebuildFilters = (reset=false, level='network') => {
        const oldPoints = reset ? new Set() : checked(pointRoot);
        const oldPeriods = reset ? new Set() : checked(periodRoot);
        const oldHeights = reset && network.value === 'LiDAR' ? new Set(['100'])
          : (reset ? new Set() : checked(heightRoot));
        const points = validation.points.filter((item) => item.network === network.value);
        if (level === 'network') renderChecks(pointRoot, points.map((item) => [item.point, item.name]), oldPoints,
          () => rebuildFilters(false, 'point'));
        const selectedPoints = checked(pointRoot);
        const periods = [...new Set(points.filter((item) => selectedPoints.has(item.point))
          .flatMap((item) => item.available_periods))].sort();
        if (level !== 'period' && level !== 'height') renderChecks(periodRoot,
          periods.map((value) => [value, validation.periods[value].label]), oldPeriods,
          () => rebuildFilters(false, 'period'));
        const selectedPeriods = checked(periodRoot);
        const heights = [...new Set(validation.metrics.filter((row) => row.network === network.value
          && selectedPoints.has(row.point) && selectedPeriods.has(String(row.period))).map((row) => row.height_m))].sort((a,b) => a-b);
        if (level !== 'height') renderChecks(heightRoot, heights.map((value) => [value,
          network.value === 'LiDAR' && value === 250
            ? '250 m — P0 descritivo; fora da seleção científica' : `${value} m`]), oldHeights, renderSummary);
        renderSummary();
      };
      const formatAggregate = (value) => Number.isFinite(value) ? number(value) : 'indisponível';

      function renderSummary() {
        const points = checked(pointRoot), periods = checked(periodRoot), heights = checked(heightRoot);
        const rows = validation.metrics.filter((row) => mpasSources.includes(row.source)
          && row.network === network.value && points.has(row.point)
          && periods.has(String(row.period)) && heights.has(String(row.height_m)));
        const aggregates = aggregateMetrics(rows);
        const winners = aggregateWinners(aggregates, metric.value);
        results.innerHTML = aggregates.map((row) => `<article class="aggregate-card" data-source="${row.source}">
          <strong>${row.source}${winners.includes(row.source) ? ' · <span class="metric-best">melhor na métrica selecionada</span>' : ''}</strong>
          <dl><dt>Viés médio</dt><dd>${formatAggregate(row.bias)} m s⁻¹</dd>
          <dt>RMSE médio¹</dt><dd>${formatAggregate(row.rmse)} m s⁻¹</dd>
          <dt>Correlação média²</dt><dd>${formatAggregate(row.r)}</dd>
          <dt>Murphy skill médio³</dt><dd>${Number.isFinite(row.skill_vs_era5)
            ? `${number(row.skill_vs_era5)} <span class="metric-unit">adimensional</span>` : 'indisponível'}</dd>
          <dt>Unidades</dt><dd>${row.n_units}</dd>
          <dt>Unidades com Murphy skill</dt><dd>${row.n_skill_units}</dd></dl></article>`).join('');
        gainLoss.innerHTML = mpasSources.map((source) => {
          const counts = {gain: 0, loss: 0, not_detected: 0, not_evaluated: 0};
          rows.filter((row) => row.source === source).forEach((row) => { counts[classifySkill(row)] += 1; });
          return `<div class="gain-loss-item"><strong>${source}</strong>
            <span>Ganhos detectáveis: ${counts.gain}</span><span>Perdas detectáveis: ${counts.loss}</span>
            <span>Diferenças não detectáveis: ${counts.not_detected}</span><span>Não avaliadas: ${counts.not_evaluated}</span></div>`;
        }).join('');
        const unit = network.value === 'INMET' ? 'estação–período' : 'sítio–período–altura';
        const descriptiveNote = rows.some((row) => row.selection_role === 'descriptive_only')
          ? ' P0/250 m é descritivo e permanece excluído dos testes de seleção científica.' : '';
        meta.innerHTML = `<strong>Unidade com peso igual:</strong> ${unit}. Vencedor descritivo em ${metric.options[metric.selectedIndex].text.toLowerCase()}: ${winners.join('/') || 'indisponível'}.${descriptiveNote}`;
        status.textContent = `¹ Média aritmética dos RMSEs individuais, não RMSE combinado. ² Média descritiva dos coeficientes r; sem IC ou teste agregado. ³ Murphy skill médio (adimensional) é a média das reduções relativas de MSE das unidades observacionais, calculadas nos mesmos horários; não é necessariamente a redução de um MSE obtido após agrupar todas as observações. Em uma unidade, 0,41 equivale a 41% de redução do MSE frente ao ERA5. Disponível para INMET a 10 m e LiDAR a 100 m.`;
      }
      network.addEventListener('change', () => rebuildFilters(true, 'network'));
      metric.addEventListener('change', renderSummary);
      rebuildFilters(true, 'network');
    }

    const analyticalTables = parseData('table-data') || {};
    if (analyticalTables.selection && document.getElementById('comparacao-direta')) {
      const rows = analyticalTables.selection.rows.map((row) => row.raw);
      const experimentA = document.getElementById('pair-experiment-a');
      const experimentB = document.getElementById('pair-experiment-b');
      const site = document.getElementById('pair-site');
      const period = document.getElementById('pair-period');
      const height = document.getElementById('pair-height');
      const result = document.getElementById('pair-result');
      const status = document.getElementById('pair-status');
      mpasSources.forEach((source) => { experimentA.add(new Option(source, source)); experimentB.add(new Option(source, source)); });
      experimentA.value = 'CTL'; experimentB.value = 'EXP03';
      const pairOptions = (control, values, label=(value) => value) => {
        const old = control.value;
        control.replaceChildren(...values.map((value) => new Option(label(value), String(value))));
        if (values.map(String).includes(String(old))) control.value = old;
      };
      const candidateRows = () => rows.filter((row) => (row.experiment_a === experimentA.value && row.experiment_b === experimentB.value)
        || (row.experiment_a === experimentB.value && row.experiment_b === experimentA.value));
      function syncPair(level='experiments') {
        if (experimentA.value === experimentB.value) {
          experimentB.value = mpasSources.find((source) => source !== experimentA.value);
        }
        const candidates = candidateRows();
        if (level === 'experiments') pairOptions(site, [...new Set(candidates.map((row) => row.site))].sort());
        const siteRows = candidates.filter((row) => String(row.site) === site.value);
        if (level !== 'period' && level !== 'height') pairOptions(period, [...new Set(siteRows.map((row) => row.period))].sort(),
          (value) => validation.periods[String(value)] ? validation.periods[String(value)].label : value);
        const periodRows = siteRows.filter((row) => String(row.period) === period.value);
        if (level !== 'height') pairOptions(height, [...new Set(periodRows.map((row) => row.height_m))].sort((a,b) => a-b), (value) => `${value} m`);
        renderPair();
      }
      function renderPair() {
        const comparison = orientPairwise(rows, experimentA.value, experimentB.value, site.value, period.value, height.value);
        if (!comparison) {
          result.innerHTML = '<div class="unavailable"><strong>Comparação não avaliada</strong></div>';
          status.textContent = 'Não existe teste pareado para esta combinação; nenhum contraste foi inferido.'; return;
        }
        const numerical = Math.abs(comparison.rmse_a - comparison.rmse_b) < 1e-10 ? 'empate numérico'
          : (comparison.rmse_a < comparison.rmse_b ? comparison.experiment_a : comparison.experiment_b);
        const detected = comparison.hi < 0 ? comparison.experiment_a : (comparison.lo > 0 ? comparison.experiment_b : null);
        const conclusion = detected ? `Diferença detectada: ${detected} apresenta menor MSE no contraste pareado.`
          : 'Diferença não detectada: o IC95% inclui zero; isso não demonstra equivalência.';
        result.innerHTML = `<div class="comparison-grid">
          <div class="comparison-cell"><small>RMSE de ${comparison.experiment_a}</small><strong>${number(comparison.rmse_a)} m s⁻¹</strong></div>
          <div class="comparison-cell"><small>RMSE de ${comparison.experiment_b}</small><strong>${number(comparison.rmse_b)} m s⁻¹</strong></div>
          <div class="comparison-cell"><small>MSE(A) − MSE(B)</small><strong>${number(comparison.delta_mse)} m² s⁻²</strong><small>IC95% [${number(comparison.lo)}; ${number(comparison.hi)}]</small></div>
          <div class="comparison-cell"><small>Horas pareadas</small><strong>n = ${comparison.n}</strong><small>Melhor valor numérico: ${numerical}</small></div>
        </div><p class="comparison-conclusion"><strong>${conclusion}</strong></p>`;
        status.textContent = `Convenção de sinal nesta ordem: MSE(${comparison.experiment_a}) − MSE(${comparison.experiment_b}). Valor negativo favorece ${comparison.experiment_a}; positivo favorece ${comparison.experiment_b}. Ao inverter A e B, sinal e limites do IC são invertidos.`;
      }
      experimentA.addEventListener('change', () => syncPair('experiments'));
      experimentB.addEventListener('change', () => syncPair('experiments'));
      site.addEventListener('change', () => syncPair('site'));
      period.addEventListener('change', () => syncPair('period'));
      height.addEventListener('change', renderPair);
      syncPair('experiments');
    }
  })();
</script>
</body>
</html>
